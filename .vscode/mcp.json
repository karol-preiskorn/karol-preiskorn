{
  "inputs": [
    {
      "type": "promptString",
      "id": "wordpress-app-password",
      "description": "WordPress Application Password",
      "password": true
    }
  ],
  "servers": {
    "wordpress-avada": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@automattic/mcp-wordpress-remote"
      ],
      "env": {
        "WP_API_URL": "https://ultimasolution.pl/wp-json/mcp/mcp-adapter-default-server",
        "OAUTH_ENABLED": "false",
        "WP_API_USERNAME": "karol",
        "WP_API_PASSWORD": "${input:wordpress-app-password}",
        "CUSTOM_HEADERS": "{\"MCP-Protocol-Version\":\"2025-11-25\"}"
      }
    },
    "wordpress-yoast": {
      "type": "http",
      "url": "https://ultimasolution.pl/wp-json/easy-mcp-ai/v1/mcp"
    }
  }
}
